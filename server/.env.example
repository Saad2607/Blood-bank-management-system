# Server Port (Render injects its own PORT automatically in production)
PORT=8080

# Environment Mode
NODE_ENV=production

# MongoDB Connection String (Atlas URI)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloodbank?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_super_secret_jwt_key_here
